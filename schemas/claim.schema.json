{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/claim.schema.json",
  "title": "Evidence Claim",
  "type": "object",
  "required": [
    "id",
    "intervention_id",
    "claim",
    "claim_type",
    "status",
    "confidence",
    "source_ids",
    "limitations",
    "last_reviewed"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^CLM-[A-Z0-9-]+$"
    },
    "intervention_id": {
      "type": "string",
      "pattern": "^INT-[A-Z0-9-]+$"
    },
    "claim": {
      "type": "string",
      "minLength": 10
    },
    "claim_type": {
      "enum": [
        "benefit",
        "risk",
        "mechanism",
        "context",
        "signal"
      ]
    },
    "status": {
      "enum": [
        "supported",
        "supported_with_qualification",
        "mixed",
        "emerging",
        "not_established",
        "contradicted"
      ]
    },
    "confidence": {
      "enum": [
        "high",
        "moderate",
        "low",
        "unknown"
      ]
    },
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^SRC-[A-Z0-9-]+$"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "last_reviewed": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "source_claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "summary"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^SRC-[A-Z0-9-]+$"
          },
          "summary": {
            "type": "string",
            "minLength": 10
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
