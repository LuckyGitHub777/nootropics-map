{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/intervention.schema.json",
  "title": "Intervention",
  "type": "object",
  "required": [
    "id",
    "slug",
    "name",
    "category",
    "simple_summary",
    "detailed_summary",
    "evidence_band",
    "claim_ids",
    "reviewed_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^INT-[A-Z0-9-]+$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 2
    },
    "category": {
      "enum": [
        "behavior",
        "environment",
        "exercise",
        "nutrition",
        "medicine",
        "neurotechnology",
        "education",
        "social",
        "research"
      ]
    },
    "simple_summary": {
      "type": "string",
      "minLength": 20
    },
    "detailed_summary": {
      "type": "string",
      "minLength": 40
    },
    "evidence_band": {
      "enum": [
        "emerging",
        "moderate",
        "strong"
      ]
    },
    "claim_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^CLM-[A-Z0-9-]+$"
      }
    },
    "reviewed_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "safety_note": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
